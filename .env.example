NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_NAME=code_quest
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Trusted reverse proxy IPs/CIDRs, comma-separated. Empty disables trust.
# Example only: TRUST_PROXY=172.18.0.3 (verify/pin Traefik's IP before use).
TRUST_PROXY=
# Required for application startup. Generate your own random values.
# JWT_SECRET: at least 32 characters. ENCRYPTION_KEY: 32 bytes as 64 hex characters.
JWT_SECRET=
ENCRYPTION_KEY=
# Set false to deploy without Discord OAuth. Credentials are required when enabled in production.
DISCORD_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
FRONTEND_URL=http://localhost:8080
# Optional origin for Swagger's server selector, without /api
# HOST_API=https://api.example.com
# Dedicated disposable database only. Required by pnpm test:e2e.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/code_quest_test
# Required only to generate roadmaps. The API starts without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=25000

# json for production; pretty for compact local output.
# When unset: pretty only in NODE_ENV=development, JSON otherwise.
LOG_FORMAT=json
# Time zone for pretty logs; JSON timestamps remain UTC.
LOG_TIMEZONE=America/Argentina/Buenos_Aires
